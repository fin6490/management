# Betfair account + API (never commit the real .env)
BF_USERNAME=
BF_PASSWORD=
BF_APP_KEY=
BF_CERTS_DIR=./certs

# Bankroll and risk limits (GBP)
BANKROLL=100
KELLY_FRACTION=0.25        # bet a quarter of the full-Kelly stake
MIN_EDGE=0.03              # need +3% expected value after commission to bet
MIN_STAKE=1.00             # Betfair's minimum stake for your account currency
MAX_STAKE=5.00             # hard cap per bet
MAX_MARKET_EXPOSURE=10.00  # max money at risk in one market
DAILY_LOSS_LIMIT=20.00     # stop placing bets after losing this much today
COMMISSION=0.05            # your Betfair market base rate (2-5%)
KILL_SWITCH_FILE=KILL      # create this file to stop all new bets immediately

# Which markets to stream in paper/live mode
EVENT_TYPE_IDS=7           # 7 = horse racing, 1 = football, 4339 = greyhounds
COUNTRY_CODES=GB,IE
MARKET_TYPES=WIN
SECONDS_BEFORE_START=300   # only bet in the last N seconds before the off

# Your model's prices: CSV with market_id,selection_id,probability
FAIR_PRICES_CSV=data/fair_prices.csv
